library(ggplot2)
library(dplyr)
library(patchwork)
library(scales)
library(forcats)
library(ggrepel)


virus_data <- data.frame(
  phylum = c("Uroviricota", "Unclassified", "Nucleocytoviricota", 
             "Preplasmiviricota", "Hofneiviricota", "Cressdnaviricota",
             "Peploviricota", "Kitrinoviricota"),
  value = c(48278, 7232, 528, 36, 10, 2, 2, 1)
)


total <- sum(virus_data$value)


ring_data <- data.frame(
  category = c("Uroviricota", "Unclassified", "Others"),
  value = c(48278, 7232, 579)  # Others = 528+36+10+2+2+1 = 579
) %>%
  mutate(
    percentage = value / total * 100,
    ymax = cumsum(percentage),
    ymin = c(0, head(ymax, n = -1)),
    label_position = (ymin + ymax) / 2,
    label = paste0(category, "\n", round(percentage, 1), "%\n(", format(value, big.mark = ","), ")")
  )


pie_data <- virus_data %>%
  filter(!phylum %in% c("Uroviricota", "Unclassified")) %>%
  mutate(
    phylum = factor(phylum, levels = phylum[order(value, decreasing = TRUE)]),
    percentage = value / 579 * 100,  # 在Others内部的百分比
    # 计算饼图位置
    ymax = cumsum(percentage),
    ymin = c(0, head(ymax, n = -1)),
    label_position = (ymin + ymax) / 2,
    
    label = ifelse(value > 10, 
                   paste0(phylum, "\n", value, "\n(", round(percentage, 1), "%)"),
                   paste0(phylum, "\n", value))
  )


colors_ring <- c("#4e79a7", "#f28e2b", "#e15759")


colors_pie <- c(
  "#59a14f",  # Nucleocytoviricota
  "#edc949",  # Preplasmiviricota
  "#b07aa1",  # Hofneiviricota
  "#ff9da7",  # Cressdnaviricota
  "#9c755f",  # Peploviricota
  "#bab0ac"   # Kitrinoviricota
)


ring_plot <- ggplot(ring_data, aes(ymax = ymax, ymin = ymin, xmax = 4, xmin = 3, fill = category)) +
  geom_rect() +
  geom_text(aes(x = 3.5, y = label_position, label = label), 
            size = 3.8, fontface = "bold", color = "white", lineheight = 0.85) +
  coord_polar(theta = "y") +
  xlim(c(2, 4)) +
  scale_fill_manual(values = colors_ring) +
  theme_void() +
  theme(
    legend.position = "none",
    plot.title = element_text(hjust = 0.5, size = 14, face = "bold")
  ) +
  ggtitle("Viral Phyla Distribution")


pie_plot <- ggplot(pie_data, aes(ymax = ymax, ymin = ymin, xmax = 4, xmin = 0, fill = phylum)) +
  geom_rect() +
  
  geom_text(data = filter(pie_data, value > 10),
            aes(x = 2, y = label_position, label = label),
            size = 3.5, fontface = "bold", color = "white", lineheight = 0.85) +
  
  geom_text_repel(data = filter(pie_data, value <= 10),
                  aes(x = 4.5, y = label_position, label = label),
                  size = 3.2, fontface = "bold",
                  nudge_x = 0.5, segment.size = 0.2,
                  min.segment.length = 0.1) +
  coord_polar(theta = "y") +
  xlim(c(0, 4.5)) +
  scale_fill_manual(values = colors_pie) +
  theme_void() +
  theme(
    legend.position = "none",
    plot.title = element_text(hjust = 0.5, size = 14, face = "bold")
  ) +
  ggtitle("Others Composition (579)") +
 
  annotate("segment",
           x = 0.5, xend = 1.5,
           y = 0.5, yend = 0.5,
           arrow = arrow(type = "closed", length = unit(0.2, "cm")),
           color = "#e15759", size = 1)


combined_plot <- ring_plot + pie_plot +
  plot_layout(widths = c(1, 1)) +
  plot_annotation(
    title = "Viral Phyla Distribution Analysis",
    subtitle = "Left: Main phyla distribution, Right: Detailed breakdown of 'Others'",
    theme = theme(
      plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
      plot.subtitle = element_text(hjust = 0.5, size = 12)
    )
  )


print(combined_plot)

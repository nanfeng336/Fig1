library(permute)
library(lattice)
library(ggplot2)
library(ggExtra)
library(vegan)
library(ggthemes)
library(tidyverse)

data <- read.table("1111.txt", header=TRUE,sep = "\t", row.names = 1) %>% t()
group <- read.delim('group.txt', sep = '\t', stringsAsFactors = FALSE)


bray <- vegdist(data, method = 'bray')

bray <- as.matrix(bray)
write.table(bray,"bray-crutis.txt",sep = "\t") 

1
pcoa <- cmdscale(bray, k = (nrow(data) - 1), eig = T)


pcoa_data <- data.frame({pcoa$point})


pcoa_data$Sample_ID <- rownames(pcoa_data)
names(pcoa_data)[1:3] <- paste0("PCoA", 1:3)


eig = pcoa$eig
eig_percent <- round(pcoa$eig/sum(eig)*100,1)



poi = pcoa$points
poi = as.data.frame(poi)


pcoa_result <- cbind(pcoa_data,group )#PCoA值和tax表/OTU表合并
head(pcoa_result)

dune.div <- adonis2(data ~ group2, data = group, permutations = 999, method="bray")
dune.div
dune_adonis <- paste0("adonis R2: ",round(dune.div$R2,2), "; P-value: ", dune.div$`Pr(>F)`)
dune_adonis


otu.bray = adonis2(data ~ group2 + group3,
                   by = "terms",
                   data = group,permutations = 999,
                   method="bray")

adonis <- otu.bray %>% 
  as.data.frame() %>% 
  mutate(., treat = rownames(.)) %>% 
  select(., treat, R2 ,`Pr(>F)`) %>% 
  slice(., 1:2)   
bc_adonis <- paste0(adonis$treat, " adonis R2: ",round(adonis$R2,2), "; P-value: ", adonis$`Pr(>F)`)      
bc_adonis=as.data.frame(bc_adonis) 



tab2 <- ggtexttable(bc_adonis, rows = NULL, 
                    theme = ttheme("blank")) %>% 
  tab_add_hline(at.row = 1:2, row.side = "top", linewidth = 1)  %>% 
  tab_add_hline(at.row = nrow(bc_adonis)+1, row.side = "bottom", linewidth = 1)

tab2




p <- ggplot(pcoa_result, aes(x = PCoA1, y = PCoA2)) +
  geom_point(aes(color = group2, shape = group3), size = 5, stroke = 1.5) +
  scale_shape_manual(values = c(15, 1, 17,16)) +
  labs(x = paste("PCoA 1 (", eig_percent[1], "%)", sep = ""),
       y = paste("PCoA 2 (", eig_percent[2], "%)", sep = ""),
       caption = bc_adonis) +
  scale_colour_manual(values = c("#FDF4BA", "#1399E7", "#F37A08")) +
  theme_minimal() +
  theme(legend.position = c(1.2, 0.8),
        legend.title = element_blank(),
        panel.grid = element_blank(),
        plot.title = element_text(hjust = 0.5),
        panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        panel.background = element_rect(color = 'black', fill = 'transparent'),
        axis.text = element_text(color = "black", size = 10)) +
  geom_hline(aes(yintercept = 0), colour = "#BEBEBE", linetype = "dashed") +
  geom_vline(aes(xintercept = 0), colour = "#BEBEBE", linetype = "dashed")


p <- p + stat_ellipse(data = pcoa_result, 
                      geom = "polygon", 
                      level = 0.9, 
                      linetype = 2, 
                      linewidth = 0.5, 
                      aes(fill = group2), 
                      alpha = 0.3, 
                      show.legend = TRUE)


p <- p + scale_fill_manual(values = c("#FDF4BA", "#1399E7", "#F37A08"))

p


 ggMarginal(
  p,
  type =c('density'),
  margins = 'both',
  size = 3.5,
  groupColour = F,
  groupFill = T
) 
